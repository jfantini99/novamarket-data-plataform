# Copie para .env e preencha. O arquivo .env NUNCA vai para o Git.
# Nao coloque access keys da AWS aqui: use AWS profiles (aws configure --profile novamarket-dev).

# --- Geral ---
NOVAMARKET_ENV=dev
NOVAMARKET_DATA_SCALE=small        # tiny | small | medium

# --- AWS (via profile, sem chaves) ---
# Descomente quando usar a AWS real (Fase 4); em dev local o S3 é o RustFS:
# AWS_PROFILE=novamarket-dev
AWS_REGION=sa-east-1
NOVAMARKET_S3_BUCKET=novamarket-data-dev-CHANGEME
# Em dev local sem custo, aponte para o MinIO (S3 local):
# AWS_ENDPOINT_URL=http://localhost:9000

# --- S3 local (RustFS, Docker). Substitui o S3 real em dev sem custo ---
S3_LOCAL_ACCESS_KEY=nm_local_admin
S3_LOCAL_SECRET_KEY=CHANGEME

# --- PostgreSQL ERP (local, Docker) ---
ERP_DB_HOST=localhost
ERP_DB_PORT=5433
ERP_DB_NAME=erp
ERP_DB_USER=erp_user
ERP_DB_PASSWORD=CHANGEME

# --- APIs simuladas (E-commerce e Marketing) ---
MOCK_API_URL=http://localhost:8081
MOCK_API_KEY=CHANGEME

# --- Airflow (local, Docker) ---
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=CHANGEME
AIRFLOW_FERNET_KEY=CHANGEME

# --- Snowflake (so a partir da Fase 6) ---
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=NM_ENGINEER
SNOWFLAKE_WAREHOUSE=NM_WH_XS
SNOWFLAKE_DATABASE=NOVAMARKET



